server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    # Railway's private network is IPv6-only and a service gets a new address on
    # every redeploy. Resolving through Railway's internal DNS on a 1-second TTL,
    # with the upstream held in a variable so nginx re-resolves per request, is
    # what keeps this working after the API or web service restarts. A literal
    # proxy_pass host would be resolved once at startup and then go stale.
    resolver [fd12::10] ipv6=on valid=1s;

    set $api_upstream    http://${API_HOST}:${API_PORT};
    set $web_upstream    http://${WEB_HOST}:${WEB_PORT};
    set $plugin_upstream http://${PLUGIN_DAEMON_HOST}:${PLUGIN_DAEMON_PORT};

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_redirect off;
    proxy_buffering off;

    # Streamed model responses and long workflow runs both need a generous read
    # timeout, or the answer is cut off mid-sentence.
    proxy_read_timeout ${PROXY_READ_TIMEOUT}s;
    proxy_send_timeout ${PROXY_READ_TIMEOUT}s;
    proxy_connect_timeout 60s;

    location /console/api { proxy_pass $api_upstream; }
    location /api         { proxy_pass $api_upstream; }
    location /v1          { proxy_pass $api_upstream; }
    location /openapi     { proxy_pass $api_upstream; }
    location /files       { proxy_pass $api_upstream; }
    location /mcp         { proxy_pass $api_upstream; }
    location /triggers    { proxy_pass $api_upstream; }
    location /callbacks/human-input/v2/im/ { proxy_pass $api_upstream; }

    location /socket.io/ {
        proxy_pass $api_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;
    }

    # Plugin webhook endpoints. The daemon needs to know the URL it was reached
    # on so it can hand the right callback address to the plugin.
    location /e/ {
        proxy_pass $plugin_upstream;
        proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
    }

    location /explore { proxy_pass $web_upstream; }
    location /        { proxy_pass $web_upstream; }
}
